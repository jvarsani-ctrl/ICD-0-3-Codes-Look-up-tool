  "dual_group_rules": {
    "_comment": "Transcribed from Decision Tree JSON Build master §6. Consulted at Moment 1 (routePresentation, before any tree loads, when candidates.length > 1) and/or Moment 2 (resolveGroup at a terminal, Architecture §6). Engine walks branches[] in order; first match wins; falls to default if none match.",
    "9811-9819": {
      "codes": [
        "9811",
        "9812",
        "9813",
        "9814",
        "9815",
        "9816",
        "9817",
        "9818",
        "9819"
      ],
      "label": "B lymphoblastic leukemia/lymphoma family",
      "topography_dependent": true,
      "discriminator": "primary_compartment",
      "branches": [
        {
          "when": {
            "captured_variable": "marrow_blast_percentage",
            "operator": ">=",
            "value": 25
          },
          "result": {
            "group": 1,
            "subgroup": "Ia1"
          },
          "note": "≥25% marrow blasts overrides a nodal/extranodal presentation — routes to Group I regardless of compartment."
        },
        {
          "when": {
            "captured_variable": "primary_compartment",
            "equals": "marrow"
          },
          "result": {
            "group": 1,
            "subgroup": "Ia1"
          }
        },
        {
          "when": {
            "topography_in": [
              "C42.0",
              "C42.1",
              "C42.3",
              "C42.4"
            ]
          },
          "result": {
            "group": 1,
            "subgroup": "Ia1"
          }
        },
        {
          "when": {
            "captured_variable": "primary_compartment",
            "equals": "nodal"
          },
          "result": {
            "group": 2,
            "subgroup": "IIb1"
          }
        },
        {
          "when": {
            "captured_variable": "primary_compartment",
            "equals": "extranodal"
          },
          "result": {
            "group": 2,
            "subgroup": "IIb1"
          }
        }
      ],
      "default": {
        "group": 2,
        "subgroup": "IIb1"
      },
      "note": "Includes 9819 (B-ALL, BCR::ABL1-like/Ph-like) alongside 9811-9818: 9819 is an ICD-O-3.2 addition postdating DT master §6's table (Pathway §5.7), belongs to the same B-ALL family, and group_01_dt.json sets topography_dependent:true on it with the identical routing note applied to 9811-9818.",
      "spleen_carveout_note": "C42.2 (spleen) is deliberately excluded from the C42.x branch here, consistent with the 9591 rule's carve-out -- not a transcription slip. DT master §6's literal text says only 'C42.x' without naming spleen, but the registry reads it the same way it reads 9591 (spleen presentation of a B-ALL-family code is not marrow-primary)."
    },
    "9823": {
      "codes": [
        "9823"
      ],
      "label": "B-CLL / small lymphocytic lymphoma",
      "topography_dependent": true,
      "discriminator": "primary_compartment",
      "branches": [
        {
          "when": {
            "captured_variable": "primary_compartment",
            "equals": "marrow"
          },
          "result": {
            "group": 1,
            "subgroup": "Ia2"
          }
        },
        {
          "when": {
            "topography_in": [
              "C42.0",
              "C42.1",
              "C42.3",
              "C42.4"
            ]
          },
          "result": {
            "group": 1,
            "subgroup": "Ia2"
          }
        },
        {
          "when": {
            "captured_variable": "primary_compartment",
            "equals": "nodal"
          },
          "result": {
            "group": 2,
            "subgroup": "IIb2"
          }
        }
      ],
      "default": {
        "group": 2,
        "subgroup": "IIb2"
      },
      "spleen_carveout_note": "C42.2 (spleen) is deliberately excluded from the C42.x branch here, consistent with the 9591 rule's carve-out -- not a transcription slip. DT master §6's literal text says only 'C42.x' without naming spleen, but the registry reads it the same way it reads 9591."
    },
    "9827": {
      "codes": [
        "9827"
      ],
      "label": "Adult T-cell leukemia/lymphoma (ATLL)",
      "topography_dependent": true,
      "discriminator": "primary_compartment",
      "branches": [
        {
          "when": {
            "captured_variable": "primary_compartment",
            "equals": "marrow"
          },
          "result": {
            "group": 1,
            "subgroup": "Ia3"
          },
          "note": "Leukaemic phase."
        },
        {
          "when": {
            "captured_variable": "primary_compartment",
            "equals": "nodal"
          },
          "result": {
            "group": 2,
            "subgroup": "IIb3"
          },
          "note": "Lymphoma phase."
        }
      ],
      "default": {
        "group": 2,
        "subgroup": "IIb3"
      },
      "note": "HTLV-1 serology mandatory before coding either way (clinical_alert, DT master §5)."
    },
    "9591": {
      "codes": [
        "9591"
      ],
      "label": "Malignant lymphoma, non-Hodgkin, NOS",
      "topography_dependent": true,
      "discriminator": "site",
      "branches": [
        {
          "when": {
            "topography_in": [
              "C42.0",
              "C42.1",
              "C42.3",
              "C42.4"
            ]
          },
          "result": {
            "group": 1,
            "subgroup": "Ia4"
          }
        }
      ],
      "default": {
        "group": 2,
        "subgroup": "IIb4"
      },
      "note": "Group-1-specific dual-group rule (Pathway §1, §5.3). C42.2 (spleen) and every other site fall to the default — this is exactly why C42.0-C42.4 must be individually addressable in topography_codes.json, not lumped as C42.x."
    },
